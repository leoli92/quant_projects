# This repo tracks only selected portfolio projects, not the whole
# workspace. Ignore everything by default, then explicitly un-ignore the
# tracked project directories.
/*
!/pairs_trading/
!/factor_research/
!/home-credit-default/
!/.gitignore

# Standard excludes within tracked projects
**/.venv/
**/.venv-*/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.ipynb_checkpoints/
